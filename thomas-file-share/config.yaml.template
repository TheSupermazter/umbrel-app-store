# FileBrowser Quantum configuration. Umbrel renders this file to config.yaml on
# install and update, through envsubst: never use a dollar sign in here.
server:
  port: 80
  database: "/home/filebrowser/data/database.db"
  cacheDir: "/home/filebrowser/data/tmp"
  externalUrl: "https://download.thomasnorden.nl"
  disablePreviews: true
  disableUpdateCheck: true
  disableWebDAV: true
  sources:
    - path: "/srv"
      name: "Nordflix"
      config:
        # Nothing can be changed or deleted, whatever an account's permissions say.
        readOnly: true
        # No public share links.
        private: true
        # A new account sees nothing until its folder (scope) is set, e.g. /Maud.
        defaultEnabled: false
        defaultUserScope: "/geen-toegang"
auth:
  tokenExpirationHours: 2
  adminUsername: "admin"
  methods:
    password:
      enabled: true
      minLength: 12
      signup: false
frontend:
  name: "Downloads"
  disableDefaultLinks: true
userDefaults:
  # Both keys: the new-user form reads the older "permissions", the server the
  # newer "account.permissions".
  permissions:
    api: false
    admin: false
    modify: false
    share: false
    realtime: false
    delete: false
    create: false
    download: true
  account:
    permissions:
      api: false
      admin: false
      modify: false
      share: false
      realtime: false
      delete: false
      create: false
      download: true
