# Umbrel launcher for TorBox Media Center.
#
# TorBox Media Center has no web UI and reads its settings from environment
# variables. This launcher gives the Umbrel app a setup/status page, keeps the
# API key in the app's data folder, and runs the media center as a child
# process with those settings.
#
# This file is rendered by Umbrel with envsubst, so it must not contain any
# dollar signs. It only uses the Python standard library.

import collections
import json
import os
import signal
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

APP_MAIN = os.environ.get("TMC_APP_MAIN", "/app/main.py")
DATA_DIR = os.environ.get("TMC_DATA_DIR", "/data")
LIBRARY_DIR = os.environ.get("TMC_LIBRARY_DIR", "/library")
WORK_DIR = os.environ.get("TMC_WORK_DIR", "/tmp/torbox-media-center")
PORT = int(os.environ.get("TMC_PORT", "8080"))
# Only for running the launcher outside of Umbrel.
SKIP_MOUNT_CHECK = os.environ.get("TMC_SKIP_MOUNT_CHECK") == "1"

# The media center empties its mount path on every start, so it only ever gets
# this subfolder of the folder the user selected, never the folder itself.
MOUNT_PATH = os.path.join(LIBRARY_DIR, "torbox")

SETTINGS_FILE = os.path.join(DATA_DIR, "settings.json")
STATE_FILE = os.path.join(DATA_DIR, "state.json")

REFRESH_TIMES = ["slowest", "very_slow", "slow", "normal", "fast", "ultra_fast"]
DEFAULT_SETTINGS = {
    "api_key": "",
    "refresh_time": "normal",
    "enable_metadata": False,
    "raw_mode": False,
}

USER_AGENT = "TorBox-Media-Center/v2.0.0 TorBox/1.0"
KEY_CHECK_URL = "https://api.torbox.app/v1/api/user/me"

lock = threading.Lock()
wake = threading.Event()
stopping = threading.Event()
log_lines = collections.deque(maxlen=300)
status = {"state": "starting", "message": "Starting…", "foreign": [], "key_check": ""}
key_state = {"key": None, "rejected": False, "at": 0.0}
strm_counts = {"at": 0.0, "movies": 0, "series": 0, "total": 0}


def read_json(path, default):
    try:
        with open(path) as file:
            return json.load(file)
    except (OSError, ValueError):
        return default


def write_json(path, data):
    tmp_path = path + ".tmp"
    fd = os.open(tmp_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as file:
        json.dump(data, file, indent=2)
    os.replace(tmp_path, path)


def load_settings():
    settings = dict(DEFAULT_SETTINGS)
    saved = read_json(SETTINGS_FILE, {})
    if isinstance(saved, dict):
        settings.update({key: saved[key] for key in DEFAULT_SETTINGS if key in saved})
    if settings["refresh_time"] not in REFRESH_TIMES:
        settings["refresh_time"] = DEFAULT_SETTINGS["refresh_time"]
    return settings


def redact(text, api_key):
    if api_key:
        text = text.replace(api_key, "[hidden]")
    return text


def log(message):
    line = time.strftime("%Y-%m-%d %H:%M:%S") + " launcher " + message
    with lock:
        log_lines.append(line)
    print(line, flush=True)


def set_status(state, message, foreign=None):
    with lock:
        changed = status["state"] != state or status["message"] != message
        status["state"] = state
        status["message"] = message
        status["foreign"] = foreign or []
    if changed:
        log(message)


def check_key(api_key):
    """Returns (rejected, message). Only a clear refusal from TorBox counts as rejected."""
    request = urllib.request.Request(
        KEY_CHECK_URL,
        headers={"Authorization": "Bearer " + api_key, "User-Agent": USER_AGENT},
    )
    try:
        with urllib.request.urlopen(request, timeout=15) as response:
            body = json.load(response)
        if body.get("success"):
            return False, "TorBox accepted the API key."
        return True, "TorBox did not accept the API key."
    except urllib.error.HTTPError as error:
        if error.code in (401, 403):
            return True, "TorBox rejected the API key. Check that you copied it completely."
        return False, "Could not check the API key (TorBox answered with HTTP " + str(error.code) + ")."
    except (OSError, ValueError):
        return False, "Could not reach TorBox to check the API key."


def refresh_key_check(api_key):
    """Checks a new key right away and a rejected key again every 5 minutes."""
    recheck = key_state["rejected"] and time.time() - key_state["at"] > 300
    if api_key == key_state["key"] and not recheck:
        return
    rejected, message = check_key(api_key) if api_key else (False, "")
    key_state.update({"key": api_key, "rejected": rejected, "at": time.time()})
    with lock:
        status["key_check"] = message


def folder_identity(path):
    info = os.stat(path)
    return [info.st_dev, info.st_ino]


def foreign_files(path, limit=5):
    """Files in the mount path that the media center did not create."""
    found = []
    for root, _dirs, files in os.walk(path):
        for name in files:
            if not name.endswith(".strm"):
                found.append(os.path.relpath(os.path.join(root, name), path))
                if len(found) >= limit:
                    return found
    return found


def adopt_mount_path():
    state = read_json(STATE_FILE, {})
    state["mount_identity"] = folder_identity(MOUNT_PATH)
    write_json(STATE_FILE, state)


def check_blockers(settings):
    """Returns (state, message, foreign files) if the media center must not start."""
    if not settings["api_key"]:
        return "needs_key", "Waiting for a TorBox API key.", []
    if key_state["rejected"]:
        # Starting would empty the library and then find nothing to put in it.
        return "bad_key", "Waiting for a valid TorBox API key.", []
    if not SKIP_MOUNT_CHECK and not os.path.ismount(LIBRARY_DIR):
        return "needs_folder", "No folder is selected for this app in Umbrel.", []
    try:
        if not os.path.isdir(MOUNT_PATH):
            os.makedirs(MOUNT_PATH)
            adopt_mount_path()
            return None
        known = read_json(STATE_FILE, {}).get("mount_identity")
        if known != folder_identity(MOUNT_PATH):
            foreign = foreign_files(MOUNT_PATH)
            if foreign:
                return "blocked_folder", "The torbox folder already contains other files.", foreign
            adopt_mount_path()
    except OSError as error:
        return "folder_error", "Cannot use the torbox folder: " + str(error), []
    return None


def start_media_center(settings):
    os.makedirs(WORK_DIR, exist_ok=True)
    env = dict(os.environ)
    env.update(
        {
            "TORBOX_API_KEY": settings["api_key"],
            "MOUNT_METHOD": "strm",
            "MOUNT_PATH": MOUNT_PATH,
            "MOUNT_REFRESH_TIME": settings["refresh_time"],
            "ENABLE_METADATA": "true" if settings["enable_metadata"] else "false",
            "RAW_MODE": "true" if settings["raw_mode"] else "false",
            "PYTHONUNBUFFERED": "1",
        }
    )
    # The media center writes its cache databases to the working directory.
    process = subprocess.Popen(
        [sys.executable, APP_MAIN],
        cwd=WORK_DIR,
        env=env,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        errors="replace",
    )

    def pump():
        # The media center logs the API key on start, so every line is redacted.
        for line in process.stdout:
            line = redact(line.rstrip("\n"), settings["api_key"])
            with lock:
                log_lines.append(line)
            print(line, flush=True)

    threading.Thread(target=pump, daemon=True).start()
    return process


def stop_media_center(process):
    if process.poll() is None:
        process.terminate()
        try:
            process.wait(timeout=20)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()


def supervise():
    failures = 0
    while not stopping.is_set():
        wake.clear()
        settings = load_settings()

        refresh_key_check(settings["api_key"])
        blocker = check_blockers(settings)
        if blocker:
            set_status(*blocker)
            wake.wait(5)
            continue

        process = start_media_center(settings)
        started = time.time()
        set_status("running", "TorBox Media Center is running.")
        while process.poll() is None and not wake.is_set() and not stopping.is_set():
            time.sleep(0.5)

        if process.poll() is None:
            # Settings changed or the app is stopping.
            stop_media_center(process)
            failures = 0
            continue

        failures = failures + 1 if time.time() - started < 120 else 1
        delay = min(30 * failures, 300)
        set_status(
            "crashed",
            "TorBox Media Center stopped (exit code "
            + str(process.returncode)
            + "). Trying again in "
            + str(delay)
            + " seconds.",
        )
        wake.wait(delay)


def count_strm_files():
    with lock:
        if time.time() - strm_counts["at"] < 30:
            return dict(strm_counts)
    counts = {"at": time.time(), "movies": 0, "series": 0, "total": 0}
    for root, _dirs, files in os.walk(MOUNT_PATH):
        amount = sum(1 for name in files if name.endswith(".strm"))
        counts["total"] += amount
        top = os.path.relpath(root, MOUNT_PATH).split(os.sep)[0]
        if top in ("movies", "series"):
            counts[top] += amount
    with lock:
        strm_counts.update(counts)
    return counts


def status_payload():
    settings = load_settings()
    counts = count_strm_files()
    with lock:
        payload = dict(status)
        payload["log"] = list(log_lines)[-120:]
    payload["key_set"] = bool(settings["api_key"])
    payload["key_hint"] = settings["api_key"][-4:] if len(settings["api_key"]) >= 12 else ""
    payload["refresh_time"] = settings["refresh_time"]
    payload["enable_metadata"] = settings["enable_metadata"]
    payload["raw_mode"] = settings["raw_mode"]
    payload["movies"] = counts["movies"]
    payload["series"] = counts["series"]
    payload["total"] = counts["total"]
    return payload


PAGE = """<!doctype html>
