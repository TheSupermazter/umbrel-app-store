class Handler(BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        pass

    def send_body(self, code, content_type, body):
        self.send_response(code)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def send_json(self, code, data):
        self.send_body(code, "application/json", json.dumps(data).encode())

    def do_GET(self):
        path = self.path.split("?")[0]
        if path == "/":
            self.send_body(200, "text/html; charset=utf-8", PAGE.encode())
        elif path == "/api/status":
            self.send_json(200, status_payload())
        else:
            self.send_json(404, {"error": "not found"})

    def same_origin(self):
        # Other sites cannot send JSON to this app without a preflight, and a
        # request that does carry an Origin must come from this app's own page.
        if self.headers.get("Content-Type", "").split(";")[0].strip() != "application/json":
            return False
        origin = self.headers.get("Origin")
        if origin and origin.split("://")[-1] != self.headers.get("Host"):
            return False
        return True

    def do_POST(self):
        if not self.same_origin():
            self.send_json(403, {"error": "forbidden"})
            return
        try:
            length = int(self.headers.get("Content-Length", "0"))
            body = json.loads(self.rfile.read(min(length, 65536)) or b"{}")
        except ValueError:
            self.send_json(400, {"error": "invalid request"})
            return
        if not isinstance(body, dict):
            self.send_json(400, {"error": "invalid request"})
            return

        if self.path == "/api/settings":
            settings = load_settings()
            api_key = str(body.get("api_key", "")).strip()
            if api_key:
                settings["api_key"] = api_key
            if body.get("refresh_time") in REFRESH_TIMES:
                settings["refresh_time"] = body["refresh_time"]
            settings["enable_metadata"] = bool(body.get("enable_metadata"))
            settings["raw_mode"] = bool(body.get("raw_mode"))
            write_json(SETTINGS_FILE, settings)
            log("Settings saved.")
            wake.set()
            self.send_json(200, {"ok": True})
        elif self.path == "/api/adopt":
            try:
                adopt_mount_path()
            except OSError as error:
                self.send_json(500, {"error": str(error)})
                return
            log("The existing torbox folder was accepted from the setup page.")
            wake.set()
            self.send_json(200, {"ok": True})
        else:
            self.send_json(404, {"error": "not found"})


def main():
    os.makedirs(DATA_DIR, exist_ok=True)
    server = ThreadingHTTPServer(("0.0.0.0", PORT), Handler)
    server.daemon_threads = True

    def shutdown(_signal, _frame):
        stopping.set()
        wake.set()

    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)

    threading.Thread(target=server.serve_forever, daemon=True).start()
    log("Setup page listening on port " + str(PORT) + ".")
    supervise()
    server.shutdown()


if __name__ == "__main__":
    main()
