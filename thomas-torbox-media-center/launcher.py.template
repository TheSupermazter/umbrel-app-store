  function render(data) {
    byId("dot").className = "dot " + data.state;
    byId("message").textContent = data.message;
    byId("key-check").textContent = data.key_check || "";
    byId("stats").hidden = data.state !== "running";
    byId("movies").textContent = data.movies;
    byId("series").textContent = data.series;
    byId("total").textContent = data.total;
    byId("needs-folder").hidden = data.state !== "needs_folder";
    byId("blocked").hidden = data.state !== "blocked_folder";

    var list = byId("foreign");
    list.textContent = "";
    data.foreign.forEach(function (name) {
      var item = document.createElement("li");
      item.textContent = name;
      list.appendChild(item);
    });

    if (data.key_set) {
      byId("key-state").textContent = "A key is saved" + (data.key_hint ? " (ending in " + data.key_hint + ")" : "") + ". Leave the field empty to keep it.";
    } else {
      byId("key-state").textContent = "No key saved yet.";
    }

    if (!formLoaded) {
      byId("refresh_time").value = data.refresh_time;
      byId("enable_metadata").checked = data.enable_metadata;
      byId("raw_mode").checked = data.raw_mode;
      formLoaded = true;
    }

    var logBox = byId("log");
    var atBottom = logBox.scrollTop + logBox.clientHeight >= logBox.scrollHeight - 20;
    logBox.textContent = data.log.join("\\n");
    if (atBottom) { logBox.scrollTop = logBox.scrollHeight; }
  }

  function refresh() {
    fetch("api/status").then(function (response) { return response.json(); }).then(render).catch(function () {});
  }

  function post(path, body) {
    return fetch(path, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body)
    }).then(function (response) {
      if (!response.ok) { throw new Error("Request failed"); }
      return response.json();
    });
  }

  byId("form").addEventListener("submit", function (event) {
    event.preventDefault();
    post("api/settings", {
      api_key: byId("api_key").value.trim(),
      refresh_time: byId("refresh_time").value,
      enable_metadata: byId("enable_metadata").checked,
      raw_mode: byId("raw_mode").checked
    }).then(function () {
      byId("api_key").value = "";
      byId("saved").textContent = "Saved.";
      refresh();
    }).catch(function () {
      byId("saved").textContent = "Could not save.";
    });
  });

  byId("adopt").addEventListener("click", function () {
    if (!confirm("Everything in the torbox folder will be deleted. Continue?")) { return; }
    post("api/adopt", {}).then(refresh);
  });

  refresh();
  setInterval(refresh, 4000);
</script>
</body>
