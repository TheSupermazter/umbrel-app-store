// ---------------------------------------------------------------- folder picker

function pickFolder(start, title, button, onChosen) {
  $('foldersTitle').textContent = title;
  $('useFolder').textContent = button;
  onFolderChosen = onChosen;
  $('folders').showModal();
  return browse(start);
}

async function browse(path) {
  $('folderMsg').textContent = '';
  try {
    const data = await api('/api/folders?path=' + encodeURIComponent(path));
    browsePath = data.path;
    const parts = browsePath ? browsePath.split('/') : [];
    const crumbs = [el('button', { className: 'link', textContent: state.root_label, onclick: () => browse('') })];
    parts.forEach((p, i) => crumbs.push('/', el('button', { className: 'link', textContent: p,
      onclick: () => browse(parts.slice(0, i + 1).join('/')) })));
    $('crumbs').replaceChildren(...crumbs);
    $('folderList').replaceChildren(...(data.folders.length
      ? data.folders.map(f => el('button', { textContent: '📁 ' + f, onclick: () => browse((browsePath ? browsePath + '/' : '') + f) }))
      : [el('div', { className: 'empty', textContent: 'No subfolders here.' })]));
  } catch (e) {
    $('folderMsg').textContent = e.message;
  }
}
$('cancelFolder').onclick = () => $('folders').close();
$('useFolder').onclick = () => {
  $('folders').close();
  if (onFolderChosen) onFolderChosen(browsePath);
};
$('makeFolder').onclick = async () => {
  const name = $('newFolder').value.trim();
  if (!name) return;
  try {
    const res = await api('/api/mkdir', { path: browsePath, name });
    $('newFolder').value = '';
    browse(res.path);
  } catch (e) {
    $('folderMsg').textContent = e.message;
  }
};

// ---------------------------------------------------------------- start

(async () => {
  try {
    await loadState();
    if (view !== 'local' && !state.providers[view]) {
      const other = view === 'torbox' ? 'realdebrid' : 'torbox';
      if (state.providers[other]) view = other;
    }
    await showView(false);
    if (!state.root_ok) toast(('Download folder ' + (state.root) + ' is not writable'));
    loadOrphanCount();
  } catch (e) {
    $('items').replaceChildren(el('div', { className: 'empty error', textContent: e.message }));
  }
  pollJobs();
})();
</script>
</body>
</html>
